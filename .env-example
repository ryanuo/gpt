# ==============================================
# 环境变量配置示例 (.env 文件模板)
# 复制此文件为 .env 并根据实际需求修改
# ==============================================

# ------------------------------
# 场景1: 使用默认 g4f 服务 (无需API密钥)
# ------------------------------
# PROVIDER=               # 留空或不设置，默认使用g4f客户端服务
# COMPLETION_MODEL=gpt-4o-mini  # 可选，默认模型在api/config.py中定义
# API_KEY=                # 无需配置
# API_URL=                # 无需配置
# WX_TOKEN=your_wechat_token   # 若使用微信公众号功能，需填写微信Token


# ------------------------------
# 场景2: 使用自定义OpenAI兼容API
# ------------------------------
# PROVIDER=custom         # 指定使用自定义API
# COMPLETION_MODEL=gpt-3.5-turbo  # 自定义API支持的模型
# API_KEY=sk-xxxxxxxxxxxxxxxxxxxx  # 自定义API的密钥
# API_URL=https://api.your-custom-api.com/v1  # 自定义API的端点URL
# WX_TOKEN=your_wechat_token   # 若使用微信公众号功能，需填写微信Token


# ------------------------------
# 场景3: 仅启用微信公众号功能
# ------------------------------
# PROVIDER=               # 可留空使用g4f服务
# COMPLETION_MODEL=gpt-4o-mini  # 微信消息处理使用的模型
# API_KEY=                # 若不使用自定义API则留空
# API_URL=                # 若不使用自定义API则留空
# WX_TOKEN=your_wechat_token   # 必须填写，微信公众号消息验证用


# ------------------------------
# 场景4: /ai-post 使用静态摘要（读仓库根目录 summaries.json）
# ------------------------------
# PROVIDER=static         # 静态摘要开关；聊天、生图、公众号接口仍走 g4f
# 也可以用独立开关，二者任一为 static 即生效：
# AI_POST_MODE=static
# 说明：
#   - summaries.json 结构为 {"<文章URL>": "<概括>"}，键与 sitemap.json 的 url 字段逐字一致
#   - 命中直接返回 {"data": "...", "status_code": 200}；未命中返回 {"error": "Summary not found", "status_code": 404}
#   - 新增文章后需补 summaries.json，否则该页前端会提示「分析失败」
# COMPLETION_MODEL=auto   # 仅 g4f 模式生效，静态模式下不调用模型
